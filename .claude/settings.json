{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm dev)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": ["Bash(git push:*)", "Bash(docker:*)", "Bash(pnpm add:*)", "Bash(uv add:*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "uv run ruff format --quiet . && uv run ruff check --fix --quiet . || true" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "python3 .claude/hooks/protect_files.py" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "make check >/dev/null 2>&1 || { echo 'make check is failing: fix it before finishing.' >&2; exit 2; }" }]
      }
    ]
  }
}
