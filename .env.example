# Copy to .env and fill in. Leave CADENT_DB and GARMINTOKENS empty to use the defaults on the data volume.
# Garmin is connected in Settings; its password is never stored here.
CADENT_DB=
GARMINTOKENS=
# Your Tailscale login (e.g. you@gmail.com): only this account may connect or disconnect Garmin.
CADENT_OWNER=
# The Claude connector (docs/home-server.md). Leave both empty to keep it off.
# CADENT_URL: the tailnet address, e.g. https://box.tailnet.ts.net
# CADENT_PUBLIC_URL: the Funnel address Claude reaches, e.g. https://box.tailnet.ts.net:8443
CADENT_URL=
CADENT_PUBLIC_URL=
